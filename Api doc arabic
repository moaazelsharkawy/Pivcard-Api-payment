    "x-merchant-key: mkey_YOUR_MERCHANT_KEY_HERE"
];

$data = [
    "transactionId" => "txn_abc123"
];

$ch = curl_init($url);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_POST, true);
curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));

$response = curl_exec($ch);
curl_close($ch);

echo $response;
?>


🔒 ملاحظات أمنية مهمة
═══════════════════════════════════════════════════════════════════════════════

⚠️  لا تشارك مفتاح API الخاص بالتاجر (x-merchant-key) مع أي شخص
⚠️  لا تقم بتخزين المفاتيح في الكود المصدري (Source Code)
⚠️  استخدم متغيرات البيئة (Environment Variables) لتخزين المفاتيح
⚠️  قم بإجراء جميع طلبات API من الخادم (Server-Side) وليس من المتصفح
⚠️  التوكنات صالحة لمدة 5 دقائق فقط
⚠️  تأكد من استخدام HTTPS في جميع الطلبات


